# AcaSight 环境变量配置
# 复制此文件为 .env 并填写实际值

# 应用配置
DEBUG=false
HOST=0.0.0.0
PORT=8000

# 数据库
DATABASE_URL=sqlite:///./data/acasight.db

# Redis
REDIS_URL=redis://localhost:6379

# Qdrant 向量数据库
QDRANT_HOST=localhost
QDRANT_PORT=6333

# RAGFlow 配置
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=
RAGFLOW_DATASET_IDS=

# LangSmith 可观测性 (可选)
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=acasight
LANGCHAIN_TRACING_V2=true

# CORS 配置
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# AI 模型 API 密钥
# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Claude
CLAUDE_API_KEY=your-claude-api-key

# Ollama 本地模型
OLLAMA_BASE_URL=http://localhost:11434

# 默认模型
DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=gpt-4

# Semantic Scholar API (可选，用于更高配额)
SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-api-key

# 文件存储
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE=104857600

# Zotero 数据库路径 (可选)
ZOTERO_DB_PATH=

# JWT 密钥
JWT_SECRET=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# 日志级别
LOG_LEVEL=INFO

# === Deep Research (Phase 10) ===
NCBI_API_KEY=          # PubMed/PMC API key (optional, increases rate limit 3→10 req/s)
SEARX_URL=             # SearXNG instance URL (optional, e.g. http://localhost:8080)
TAVILY_API_KEY=        # Tavily API key (optional, AI-powered search)

# === Figure Edit SVG (Phase 10) ===
SAM3_BACKEND=fal        # SAM3 backend: fal / roboflow / local
SAM3_API_KEY=           # fal.ai API key (for SAM3 segmentation)
ROBOFLOW_API_KEY=       # Roboflow API key (alternative SAM3)
ROBOFLOW_ENDPOINT=      # Roboflow endpoint URL
RMBG_MODEL_PATH=        # RMBG2 model path (optional, for icon BG removal)
